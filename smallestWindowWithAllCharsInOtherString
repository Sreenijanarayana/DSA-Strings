class Solution {
    public static String smallestWindow(String s1, String s2) {
        if (s2.length() > s1.length()) return ""; // No valid window

        HashMap<Character, Integer> hm = new HashMap<>();
        for (char c : s2.toCharArray()) {
            hm.put(c, hm.getOrDefault(c, 0) + 1);
        }

        int l = 0, r = 0, count = hm.size(), minLen = Integer.MAX_VALUE, start = 0;
        
        while (r < s1.length()) {
            char ch = s1.charAt(r);
            if (hm.containsKey(ch)) {
                hm.put(ch, hm.get(ch) - 1);
                if (hm.get(ch) == 0) count--; // Fully matched character
            }

            while (count == 0) { // Valid window found
                if (r - l + 1 < minLen) {
                    minLen = r - l + 1;
                    start = l;
                }

                char leftChar = s1.charAt(l);
                if (hm.containsKey(leftChar)) {
                    hm.put(leftChar, hm.get(leftChar) + 1);
                    if (hm.get(leftChar) > 0) count++; // Lost a fully matched character
                }
                l++;
            }
            r++;
        }

        return minLen == Integer.MAX_VALUE ? "" : s1.substring(start, start + minLen);
    }
}
